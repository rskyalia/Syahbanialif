# ── Contact Form Email (Resend) ──────────────────────────────────
# 1. Daftar di https://resend.com (gratis — 3000 email/bulan)
# 2. Buat API Key di dashboard Resend
# 3. Copy .env.example → .env.local
# 4. Isi nilai di bawah
# 5. Jalankan: npm install resend
# 6. Uncomment blok Resend di app/api/contact/route.js

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email tujuan (penerima pesan dari contact form)
CONTACT_EMAIL=hello@syahbanialif.com
